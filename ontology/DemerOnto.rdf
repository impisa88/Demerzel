    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Adequate_Behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Adequate_Behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Harmful_Behavior"/>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#activity"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Physical_Activity"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#frequency"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Frequency"/>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    


